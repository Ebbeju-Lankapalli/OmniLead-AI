# ============================================================
# OmniLead AI
# Root environment variable reference
#
# IMPORTANT:
# - This file contains variable names only.
# - Never commit real credentials.
# - Frontend variables must never contain backend secrets.
# ============================================================


# ============================================================
# Application
# ============================================================

APP_NAME=OmniLead AI
APP_ENV=development
APP_DEBUG=true

APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

DEMO_MODE=true


# ============================================================
# Frontend / Vite
# ============================================================

VITE_APP_NAME=OmniLead AI
VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ============================================================
# PostgreSQL / Supabase Database
# ============================================================

DATABASE_URL=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# ============================================================
# Supabase
# ============================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend only.
# NEVER expose this value through Vite/frontend variables.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_JWT_AUDIENCE=authenticated

SUPABASE_CALL_RECORDINGS_BUCKET=call-recordings


# ============================================================
# Gemini
# ============================================================

GEMINI_API_KEY=

# Model names will be finalized in backend configuration.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

AI_ENABLED=true
AI_REQUEST_TIMEOUT_SECONDS=30


# ============================================================
# AI observability
# ============================================================

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omnilead-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# ============================================================
# Embeddings / Semantic Search
# ============================================================

EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMER_MODEL=

SEMANTIC_SEARCH_ENABLED=false


# ============================================================
# Redis / Celery
# ============================================================

REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

CELERY_TASK_ALWAYS_EAGER=false


# ============================================================
# Email / Resend
# ============================================================

RESEND_API_KEY=

EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=OmniLead AI

EMAIL_NOTIFICATIONS_ENABLED=false


# ============================================================
# Meta / Instagram / WhatsApp
# ============================================================

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

META_GRAPH_API_VERSION=

INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

META_WEBHOOK_ENABLED=false


# ============================================================
# Call intelligence / Faster-Whisper
# ============================================================

CALL_INTELLIGENCE_ENABLED=false

WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

MAX_AUDIO_FILE_SIZE_MB=25
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a,flac,ogg,webm


# ============================================================
# Security
# ============================================================

CORS_ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

WEBHOOK_SIGNATURE_VALIDATION=true

MAX_UPLOAD_SIZE_MB=25


# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO
LOG_FORMAT=json


# ============================================================
# Real-time / WebSockets
# ============================================================

WEBSOCKET_ENABLED=true


# ============================================================
# Demo data
# ============================================================

DEMO_ORGANIZATION_NAME=OmniLead Demo Company
DEMO_ORGANIZATION_SLUG=omnilead-demo

DEMO_ADMIN_EMAIL=demo@omnilead.local
DEMO_SEED_ENABLED=true